{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.config.ts",
    "!src/**/*.constant.ts",
    "!src/**/*.mock.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.type.ts"
  ],
  "ignorePatterns": ["coverage", "reports", "dist", ".cache", ".stryker-tmp"],
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "./scripts/stryker-plan-recorder.ts"
  ],
  "reporters": ["clear-text", "json", "plan-recorder"],
  "testRunner": "vitest",
  "thresholds": {
    "break": 80,
    "high": 80,
    "low": 80
  },
  "warnings": {
    "slow": false
  },
  "incremental": true,
  "incrementalFile": ".cache/stryker/incremental.json",
  "clearTextReporter": {
    "skipFull": true,
    "reportTests": false,
    "reportMutants": true,
    "logTests": false
  }
}
