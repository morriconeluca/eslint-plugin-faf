{
  "name": "eslint-plugin-faf",
  "version": "0.1.0",
  "description": "An ESLint plugin for FAF projects.",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    }
  },
  "imports": {
    "#_rules@shared/*": "./src/_rules/_rules@shared/*",
    "#_utils@shared/*": "./src/_rules/_rules@shared/_utils/_utils@shared/*"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run lint && tsup",
    "test": "vitest run",
    "dev": "vitest",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:types": "tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "ci": "npm run build && npm run check-format && npm run test",
    "prepublishOnly": "npm run ci",
    "local-release": "changeset version && changeset publish",
    "prepare": "husky"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "faf"
  ],
  "author": "Luca Morricone",
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/utils": "^8.24.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "tsup": "^8.3.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "src/**/*.ts": "eslint --fix"
  }
}
